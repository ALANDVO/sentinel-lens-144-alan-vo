# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/app.db

# LLM (optional - for advisory explanations only)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sentinel-lens
KEYCLOAK_CLIENT_ID=sentinel-lens-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sentinel-lens
VITE_KEYCLOAK_CLIENT_ID=sentinel-lens-frontend
